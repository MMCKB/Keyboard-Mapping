<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KeyRemapper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:KeyRemapper.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 启用开关 + 状态提示 -->
        <Grid Padding="24,20,24,0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="键盘映射" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="把某个按键即时替换成另一个按键，例如 Caps Lock → Esc。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" x:Name="EnableSwitch" Header="启用映射"
                              OnContent="" OffContent="" Toggled="OnEnableToggled"/>
            </Grid>

            <InfoBar Grid.Row="1" x:Name="StatusInfo" IsOpen="False" IsClosable="True"/>
            <InfoBar Grid.Row="2" x:Name="AdminInfoBar" IsOpen="True" IsClosable="True" Severity="Informational"
                     Title="提示"
                     Message="要让映射在管理员权限的程序（如任务管理器）中也生效，请以管理员身份运行本软件。"/>
            <InfoBar Grid.Row="3" x:Name="ScanmapInfoBar" IsOpen="False" IsClosable="True" Severity="Warning"
                     Title="系统级映射已存在"
                     Message="重启电脑后即使不运行本软件也会保持映射；它与即时映射相互独立，注意不要对同一物理按键设置会相互干扰的规则。"/>
        </Grid>

        <!-- 映射列表 + 系统级映射 + 底部操作 -->
        <Grid Grid.Row="1" Padding="24,12,24,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <ListView x:Name="MappingList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:KeyMapping">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,3">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="6" Padding="10,3">
                                            <TextBlock Text="{x:Bind FromName}" FontWeight="SemiBold"/>
                                        </Border>
                                        <FontIcon Glyph="&#xE72A;" FontSize="14" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="6" Padding="10,3">
                                            <TextBlock Text="{x:Bind ToName}" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Padding="6"
                                            Background="Transparent" BorderThickness="0"
                                            Click="OnDeleteClick" Tag="{x:Bind FromVk}">
                                        <SymbolIcon Symbol="Delete"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyHint" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="还没有映射规则。点击下方「添加映射」：先按要被替换的键，再按想要的键，映射立即生效、无需重启。"/>
            </Grid>

            <!-- 系统级映射：写入注册表 Scancode Map，重启后永久生效，无需运行本软件 -->
            <Expander Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Spacing="2">
                        <TextBlock Text="系统级映射（写入系统，无需运行本软件）" FontWeight="SemiBold"/>
                        <TextBlock Text="写入键盘驱动层（注册表 Scancode Map），重启电脑后永久生效；之后无需开机自启、不运行任何软件也保持映射。需要管理员权限。"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Margin="4,8,4,12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Style="{ThemeResource AccentButtonStyle}" Padding="16,6"
                                Click="OnApplyScanmapClick" Content="写入系统映射…"/>
                        <HyperlinkButton Margin="4,0,0,0" VerticalAlignment="Center"
                                         Click="OnRemoveScanmapClick" Content="恢复系统默认"/>
                    </StackPanel>
                    <TextBlock x:Name="ScanmapStatus" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                               Text="说明：系统级映射直接改写物理按键的扫描码，一次写入、重启后永久有效；即时映射则在本软件关闭后失效。两者可并存，即时映射收到的是系统级映射之后的按键。"/>
                </StackPanel>
            </Expander>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{ThemeResource AccentButtonStyle}" Click="OnAddClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="添加映射"/>
                    </StackPanel>
                </Button>
                <ToggleSwitch Grid.Column="2" x:Name="AutoStartToggle" Header="开机自启"
                              OnContent="" OffContent="" Toggled="OnAutoStartToggled"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
